{"config":{"lang":["zh","en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u524d\u8a00","text":""},{"location":"#_1","title":"\u524d\u8a00","text":"<p>\u672c\u4e66\u662f\u4e00\u672c\u5f00\u6e90\u514d\u8d39\u7684\u8ba1\u7b97\u673a\u81ea\u5b66\u6307\u5357\uff0c\u65e2\u662f\u6211\u732e\u7ed9\u5b66\u5f1f\u5b66\u59b9\u7684\u4e00\u4efd\u793c\u7269\uff0c\u4e5f\u662f\u6211\u4e3a\u5f00\u6e90\u793e\u533a\u6240\u505a\u7684\u4e00\u70b9\u7ef5\u8584\u4e4b\u529b\u3002</p> <p>\u5982\u679c\u8fd9\u672c\u6307\u5357\u80fd\u5bf9\u5927\u5bb6\u54ea\u6015\u4e00\u4e1d\u4e00\u6beb\u7684\u5e2e\u52a9\uff0c\u90fd\u662f\u5bf9\u6211\u6781\u5927\u7684\u9f13\u52b1\u548c\u6170\u85c9\u3002</p> <p>\u672c\u4e66\u76ee\u524d\u5305\u542b\u4e86\u4ee5\u4e0b\u90e8\u5206\uff08\u5982\u679c\u4f60\u6709\u66f4\u597d\u7684\u5efa\u8bae\uff0c\u6216\u8005\u60f3\u52a0\u5165\u8d21\u732e\u8005\u884c\u5217\uff0c\u6b22\u8fce\u901a\u8fc7\u90ae\u7bb1 zhangchaowen@stu.scu.edu.cn\u8054\u7cfb\u6211\uff0c\u6216\u8005\u5728 Issue \u4e2d\u63d0\u51fa\uff09\uff1a</p> <ul> <li>\u672c\u4e66\u4f7f\u7528\u6307\u5357\uff1a\u7531\u4e8e\u4e66\u5185\u6db5\u76d6\u8d44\u6e90\u4f17\u591a\uff0c\u6211\u6839\u636e\u4e0d\u540c\u4eba\u7fa4\u7684\u7a7a\u95f2\u65f6\u95f4\u548c\u5b66\u4e60\u76ee\u6807\u5236\u5b9a\u4e86\u5bf9\u5e94\u7684\u4f7f\u7528\u6307\u5357\u3002</li> <li>AICS\u5b66\u4e60\u89c4\u5212\uff1a\u4e00\u4efd\u4ec5\u4f9b\u53c2\u8003\u7684AICS\u5b66\u4e60\u89c4\u5212</li> </ul>"},{"location":"#_2","title":"\u661f\u5149\u542f\u7a0b\u7684\u5730\u65b9","text":"<p>\u5165\u5b66\u65f6\u6211\u662f\u4e00\u4e2a\u5bf9\u8ba1\u7b97\u673a\u4e00\u7a8d\u4e0d\u901a\u7684\u5c0f\u767d\uff0c\u9664\u4e86\u73a9\u8fc7\u7535\u8111\u6e38\u620f\uff0c\u6211\u751a\u81f3\u4e0d\u4f1a\u4e0b\u8f7d\u6b63\u89c4\u7684\u8f6f\u4ef6\u3002\u4f46\u6211\u8fd8\u662f\u6000\u7740\u65b0\u5947\u548c\u70ed\u60c5\u5f00\u59cb\u4e86\u6211\u7684\u8ba1\u7b97\u673a\u79d1\u5b66\u4e4b\u8def\u3002\u6bcf\u5929\u6211\u90fd\u4f1a\u6309\u65f6\u53bb\u6559\u5ba4\uff0c\u8ba4\u771f\u542c\u53d6\u8001\u5e08\u7684\u8bb2\u8bfe\uff0c\u505a\u597d\u7b14\u8bb0\uff0c\u7136\u540e\u5b8c\u6210\u4efb\u52a1\u3002\u7136\u800c\uff0c\u6211\u9010\u6e10\u53d1\u73b0\uff0c\u6bcf\u4e2a\u8001\u5e08\u7684\u6559\u5b66\u65b9\u5f0f\u4e0d\u540c\uff0c\u901f\u5ea6\u4e0d\u540c\uff0c\u4fa7\u91cd\u70b9\u4e0d\u540c\uff0c\u70ed\u60c5\u4e0d\u540c\u3002\u6709\u7684\u4ec5\u4ec5\u662f\u7167\u7740\u9648\u65e7\u7684ppt\u590d\u8ff0\uff0c\u6709\u7684\u4ec5\u4ec5\u662f\u589e\u52a0\u4e86\u62bd\u4eba\u56de\u7b54ppt\u4e0a\u7684\u95ee\u9898\uff0c\u771f\u6b63\u70ed\u60c5\u6295\u5165\u6559\u80b2\u8ba9\u5b66\u751f\u6279\u5224\u6027\u601d\u8003\u7684\u975e\u5e38\u5c11\uff0c\u5c31\u8fd9\u6837\u65e5\u590d\u4e00\u65e5\u7684\u67af\u71e5\u5b66\u4e60\u4e2d\uff0c\u6211\u7684\u70ed\u60c5\u9010\u6e10\u88ab\u6d88\u78e8.....\u56e0\u4e3a\u8fd9\u6837\uff0c\u6211\u66fe\u9677\u5165\u8ff7\u832b\uff0c\u6211\u4e00\u5ea6\u6000\u7591\u6211\u662f\u4e0d\u662f\u4e0d\u9002\u5408\u5b66\u8ba1\u7b97\u673a\uff0c\u56e0\u4e3a\u7ae5\u5e74\u5bf9\u4e8e\u6781\u5ba2\u7684\u6240\u6709\u60f3\u8c61\uff0c\u5df2\u7ecf\u88ab\u6211\u7b2c\u4e00\u4e2a\u5b66\u5e74\u7684\u4f53\u9a8c\u5f7b\u5e95\u7c89\u788e\u4e86\u3002\u6211\u65f6\u5e38\u95ee\u81ea\u5df1\uff0cAI\u65e2\u7136\u80fd\u505a\u8fd9\u4e48\u591a\uff0c\u6211\u7a76\u7adf\u5e94\u8be5\u638c\u63e1\u4ec0\u4e48\u77e5\u8bc6\uff1f\u6211\u8fd8\u9700\u8981\u5b66\u4e60Java\u3001Python\u5417\uff1f\u6211\u8fd8\u9700\u8981\u53bb\u5b66\u4e60\u6570\u636e\u7ed3\u6784\u3001\u8ba1\u7b97\u673a\u7f51\u7edc\u5417\uff1f\u6211\u672c\u4ee5\u4e3a\u6211\u7684\u5927\u5b66\u4f1a\u8fd9\u6837\u5e73\u6de1\u5ea6\u8fc7\uff0c\u4e0a\u8bfe\u3001\u5b66\u4e60\u3001\u5a31\u4e50\u3002\u6ca1\u4e24\u4e2a\u6708\uff0cdeepseek-v3\u6a2a\u7a7a\u51fa\u4e16\u4e86\u3002\u8eab\u8fb9\u6240\u6709\u7684\u4eba\u90fd\u5728\u5439\u5618\u8fd9\u4e2a\u51fa\u751f\u4e0d\u4e45\u7684AI\u6a21\u578b\u3002</p> <p>\u4f5c\u4e3a\u5c0f\u767d\u7684\u6211\u8ba4\u4e3a\u8fd9\u6ca1\u4ec0\u4e48\uff0c\u53ea\u662f\u591a\u4e86\u4e00\u4e2a\u80fd\u5e2e\u52a9\u6211\u7f16\u5199\u4ee3\u7801\u7684\u5de5\u5177\u3002\u6211\u4ecd\u7136\u60f3\u5f80\u5e38\u4e00\u6837\uff0c\u6309\u7167\u8ba1\u7b97\u673a\u56db\u5927\u4ef6\u7684\u987a\u5e8f\u5543\u6559\u6750\u3002\u76f4\u5230\u5feb\u8fdb\u5165\u5927\u4e8c\uff0c\u4e00\u6b21\u5076\u7136\u7684\u673a\u4f1a\uff0c\u6211\u7684\u6570\u636e\u7ed3\u6784\u8001\u5e08\u5728\u7fa4\u91cc\u53d1\u4e86\u4e00\u7bc7\u5e16\u5b50\uff0c\u90a3\u662fAndrew Ng\u5728Buildathon\u4e0a\u7684\u6f14\u8bb2\u7a3f\u3002\u770b\u5230\u5e16\u5b50\u7684\u7b2c\u4e00\u773c\u6211\u4fbf\u88ab\u6df1\u6df1\u5438\u4f4f\u4e86\uff0c\u6211\u4e00\u53e3\u6c14\u770b\u5b8c\u4e86\u5168\u90e8\u5185\u5bb9\uff0c\u4ecd\u4e0d\u6ee1\u8db3\u7684\u6211\u53c8\u53bbYoutube\u89c2\u770b\u4e86\u6f14\u8bb2\u539f\u89c6\u9891\u3002</p> <p>\u6f14\u8bb2\u56f4\u7ed5AI\u8f85\u52a9\u7f16\u7a0b\u3001\u5feb\u901f\u5f00\u53d1\u4ea7\u54c1\u539f\u578b\uff0c\u4ee5\u53caAI\u5de5\u7a0b\u5e08\u6280\u80fd\u9700\u6c42\uff0c\u8fd9\u8ba9\u6211\u771f\u6b63\u770b\u5230\u4e86\u8fd9\u4e2a\u884c\u4e1a\u4e43\u81f3\u6240\u6709\u884c\u4e1a\u672a\u6765\u7684\u8d8b\u52bf--\u7406\u89e3AI\u5e76\u638c\u63e1AI\u3002</p> <p>\u5728\u5434\u6069\u8fbe\u7684\u6f14\u8bb2\u91cc\uff0c\u6211\u6574\u7406\u4e86\u51e0\u4e2a\u91cd\u8981\u601d\u60f3\uff1a</p> <ul> <li> <p>\u201c\u5feb\u901f\u884c\u52a8\uff0c\u627f\u62c5\u8d23\u4efb\u201d\u3002AI\u8f85\u52a9\u7f16\u7a0b\u8ba9\u72ec\u7acb\u539f\u578b\u5f00\u53d1\u5b9e\u73b010\u500d\u52a0\u901f\u3002\u539f\u578b\u6210\u672c\u5927\u5e45\u964d\u4f4e\u4f7f\u5feb\u901f\u591a\u6b21\u8bd5\u9519\u6210\u4e3a\u53ef\u884c\u7b56\u7565\uff0c\u771f\u6b63\u4ef7\u503c\u5728\u4e8e\u5728\u8bd5\u9519\u4e2d\u53d1\u73b0\u503c\u5f97\u6df1\u5ea6\u5f00\u53d1\u7684\u9879\u76ee\u3002</p> </li> <li> <p>\u4ee3\u7801\u6b63\u5728\u8d2c\u503c\uff0c\u5f00\u53d1\u8005\u9700\u8981\u8f6c\u578b\u4e3a\u7cfb\u7edf\u8bbe\u8ba1\u8005\u548cAI\u6307\u6325\u8005\u3002\u7f16\u7a0b\u5de5\u5177\u5df2\u7ecf\u5386\u591a\u4ee3\u8fdb\u5316\uff1a\u4eceGitHub Copilot\u5230IDE\uff0c\u518d\u5230\u9ad8\u5ea6\u4ee3\u7406\u5316\u7684\u7a0b\u52a9\u624b\u3002\u5de5\u5177\u8fed\u4ee3\u901f\u5ea6\u521b\u9020\u5b9e\u8d28\u6027\u6548\u7387\u5dee\u8ddd\uff0c\u843d\u540e\u534a\u4ee3\u5373\u53ef\u80fd\u663e\u8457\u5f71\u54cd\u4ea7\u51fa\u80fd\u529b\u3002\u4ee3\u7801\u4ef7\u503c\u672c\u8eab\u6b63\u5728\u964d\u4f4e\u3002AI\u53ef\u81ea\u52a8\u751f\u6210\u4ee3\u7801\u3001\u8fc1\u79fb\u6570\u636e\u5e93\u67b6\u6784\uff0c\u4f7f\u67b6\u6784\u51b3\u7b56\u53d8\u5f97\u66f4\u53ef\u9006\u3002\u5f00\u53d1\u8005\u9700\u8981\u4ece\u4ee3\u7801\u7f16\u5199\u8005\u8f6c\u578b\u4e3a\u7cfb\u7edf\u8bbe\u8ba1\u8005\u548cAI\u6307\u6325\u8005\uff0c\u91cd\u70b9\u628a\u63a7\u6838\u5fc3\u67b6\u6784\u4e0e\u590d\u5408\u578b\u7cfb\u7edf\u6784\u5efa\u3002</p> </li> <li> <p>\u201cAI\u65f6\u4ee3\u65e0\u9700\u5b66\u7f16\u7a0b\u201d\u662f\u53f2\u4e0a\u6700\u7cdf\u7684\u804c\u4e1a\u5efa\u8bae\u3002\u5434\u6069\u8fbe\u5f3a\u70c8\u53cd\u5bf9\u201cAI\u65f6\u4ee3\u65e0\u9700\u5b66\u7f16\u7a0b\u201d\u7684\u89c2\u70b9\uff0c\u6307\u51fa\u5386\u53f2\u4e0a\u6bcf\u6b21\u7f16\u7a0b\u5de5\u5177\u8fdb\u6b65\u90fd\u8ba9\u66f4\u591a\u4eba\u7fa4\u5177\u5907\u7f16\u7a0b\u80fd\u529b\u3002\u4ed6\u56e2\u961f\u4e2d\u7684CFO\u3001\u6cd5\u5f8b\u987e\u95ee\u3001\u524d\u53f0\u4eba\u5458\u5747\u901a\u8fc7\u5b66\u4e60\u7f16\u7a0b\u63d0\u5347\u5de5\u4f5c\u6548\u7387\u3002\u672a\u6765\u6838\u5fc3\u6280\u80fd\u662f\u201c\u7cbe\u51c6\u544a\u8bc9\u8ba1\u7b97\u673a\u8be5\u505a\u4ec0\u4e48\u201d\uff0c\u8fd9\u9700\u8981\u7406\u89e3\u8ba1\u7b97\u673a\u8bed\u8a00\u4e0e\u7f16\u7a0b\u903b\u8f91\u3002\u975e\u6280\u672f\u4eba\u5458\u53ef\u901a\u8fc7AI\u8f85\u52a9\u5feb\u901f\u638c\u63e1\u57fa\u7840\u7f16\u7a0b\u80fd\u529b\uff0c\u5b9e\u73b0\u8de8\u9886\u57df\u6548\u7387\u63d0\u5347\u3002</p> </li> <li> <p>AI\u5de5\u7a0b\u5e08\u5947\u7f3a\uff0c\u5927\u5b66\u8bfe\u7a0b\u5374\u5df2\u4e25\u91cd\u8131\u8282\u3002\u8ba1\u7b97\u673a\u4e13\u4e1a\u6bd5\u4e1a\u751f\u5931\u4e1a\u7387\u5347\u81f37%\uff0c\u53ef\u4f01\u4e1a\u5374\u4ecd\u9762\u4e34AI\u5de5\u7a0b\u5e08\u4e25\u91cd\u77ed\u7f3a\u3002\u6838\u5fc3\u77db\u76fe\u5728\u4e8e\u5927\u5b66\u8bfe\u7a0b\u672a\u80fd\u53ca\u65f6\u8986\u76d6\u5173\u952e\u6280\u80fd\uff1aAI\u8f85\u52a9\u7f16\u7a0b\u3001\u5927\u8bed\u8a00\u6a21\u578b\u8c03\u7528\u3001RAG/Agentic\u5de5\u4f5c\u6d41\u6784\u5efa\u3001\u89c4\u8303\u9519\u8bef\u5206\u6790\u6d41\u7a0b\u7b49\u3002\u65b0\u5174AI\u5de5\u7a0b\u5e08\u9700\u638c\u63e1\u4e09\u5927\u6280\u80fd\uff1a\u4f7f\u7528\u6700\u65b0AI\u7f16\u7a0b\u5de5\u5177\u3001\u719f\u6089AI\u6784\u5efa\u6a21\u5757\uff08\u63d0\u793a\u5de5\u7a0b/\u8bc4\u4f30\u6280\u672f/MCP\uff09\u3001\u5177\u5907\u5feb\u901f\u539f\u578b\u80fd\u529b\u4e0e\u57fa\u7840\u4ea7\u54c1\u76f4\u89c9\u3002</p> </li> </ul> <p>\u540e\u6765\uff0c\u6211\u6309\u7167Andrew Ng\u6559\u6388\u7684\u5efa\u8bae\uff0c\u5728\u8fd9\u4e9b\u65b9\u5411\u4e0a\u5f00\u59cb\u81ea\u5b66\u3002\u6211\u9010\u6e10\u653e\u5f03\u4e86\u5927\u5b66\u7684\u8bfe\u5802\uff0c\u5e76\u5728\u6b64\u671f\u95f4\u627e\u5230\u4e86\u5f88\u591a\u4f18\u8d28\u7684\u8bfe\u7a0b\u8d44\u6e90\u3002\u5728\u8fd9\u6837\u7684\u8bfe\u7a0b\u4e2d\uff0c\u4f60\u5b8c\u5168\u4e0d\u9700\u8981\u4efb\u4f55\u987e\u8651\uff0c\u53ea\u9700\u8981\u52aa\u529b\u3001\u8ba4\u771f\u3001\u82b1\u65f6\u95f4\u5c31\u591f\u4e86\u3002\u6b64\u524d\u5728\u8bfe\u5802\u4e0a\u90a3\u79cd\u6709\u52b2\u6ca1\u5904\u4f7f\u7684\u611f\u89c9\uff0c\u90a3\u79cd\u4ed8\u51fa\u518d\u591a\u65f6\u95f4\u5374\u5f97\u4e0d\u5230\u56de\u62a5\u7684\u611f\u89c9\uff0c\u4ece\u6b64\u70df\u6d88\u4e91\u6563\u3002\u8fd9\u592a\u9002\u5408\u6211\u4e86\uff0c\u6211\u4ece\u6b64\u7231\u4e0a\u4e86\u81ea\u5b66\u3002</p> <p>\u5982\u679c\u4f60\u4e5f\u5728\u82e6\u607c\u5730\u5b66\u4e60\u8ba1\u7b97\u673a\u77e5\u8bc6\uff0c\u548c\u6211\u6709\u7740\u540c\u6837\u7684\u56f0\u60d1\uff0c\u4e0d\u59a8\u53bb\u770b\u770b\u5434\u6069\u8fbe\u6559\u6388\u5728 Buildathon \u4e0a\u7684\u6f14\u8bb2\uff0c\u56e0\u4e3a\u90a3\u662f\u6211\u6700\u521d\u5fc3\u52a8\u7684\u5730\u65b9\u3002</p>"},{"location":"#_3","title":"\u4e3a\u4ec0\u4e48\u5199\u8fd9\u672c\u4e66","text":"<p>\u5927\u4e8c\u79cb\u5b63\u5b66\u671f\u5b66\u4e60\u64cd\u4f5c\u7cfb\u7edf\u65f6\uff0c\u6211\u53d1\u73b0\u8001\u5e08\u8bb2\u5f97\u6781\u5176\u67af\u71e5\uff0c\u5f88\u591a\u4f8b\u5b50\u662f\u5341\u5e74\u524d\u7684\uff0c\u5b9e\u9a8c\u8bfe\u6307\u5357\u66f4\u662f 13 \u5e74\u524d\u7684\u3002\u540e\u6765\u548c\u8eab\u8fb9\u670b\u53cb\u4ea4\u8c08\uff0c\u6211\u4e5f\u80fd\u611f\u53d7\u5230\u5927\u5bb6\u5bf9 AI \u5feb\u901f\u53d1\u5c55\u7684\u62c5\u5fe7\u548c\u5bf9\u672a\u6765\u5c31\u4e1a\u7684\u7126\u8651\u3002\u90a3\u65f6\u5019\u6211\u5df2\u7ecf\u81ea\u5b66\u4e00\u5e74\u591a\u4e86\uff0c\u6574\u7406\u4e86\u5f88\u591a\u8d44\u6e90\uff0c\u4fbf\u5206\u4eab\u7ed9\u4e86\u670b\u53cb\u4eec\u2014\u2014\u6bd5\u7adf\uff0c\u8c01\u4e0d\u5e0c\u671b\u5feb\u4e50\u5730\u5ea6\u8fc7\u5927\u5b66\u65f6\u5149\uff0c\u8fd8\u80fd\u627e\u5230\u597d\u5de5\u4f5c\u6216\u8003\u4e0a\u7814\u7a76\u751f\u5462\uff1f</p> <p>\u968f\u7740\u53c8\u4e00\u5e74\u7684\u79ef\u7d2f\uff0c\u8d44\u6e90\u5185\u5bb9\u5df2\u7ecf\u76f8\u5f53\u4e30\u5bcc\uff0c\u57fa\u672c\u8986\u76d6\u4e86\u8ba1\u79d1\u3001\u667a\u80fd\u7cfb\u3001\u8f6f\u5de5\u7cfb\u7684\u7edd\u5927\u591a\u6570\u8bfe\u7a0b\u3002\u6211\u4e5f\u4e3a\u6bcf\u4e2a\u8bfe\u7a0b\u5efa\u4e86\u5404\u81ea\u7684 GitHub \u4ed3\u5e93\uff0c\u6c47\u603b\u81ea\u5b66\u8d44\u6599\u53ca\u4f5c\u4e1a\u5b9e\u73b0\u3002\u76f4\u5230\u540e\u6765\u8ba1\u7b97\u5b66\u5206\u65f6\uff0c\u6211\u6253\u5f00\u81ea\u5df1\u7684\u57f9\u517b\u65b9\u6848\uff0c\u53d1\u73b0\u5b83\u5df2\u7ecf\u662f\u6211\u8fd9\u4e2a\u81ea\u5b66\u4ed3\u5e93\u7684\u5b50\u96c6\u4e86\u2014\u2014\u800c\u8fd9\u8ddd\u79bb\u6211\u5f00\u59cb\u81ea\u5b66\u4e5f\u624d\u4e24\u5e74\u800c\u5df2\u3002\u4e8e\u662f\uff0c\u4e00\u4e2a\u5927\u80c6\u7684\u60f3\u6cd5\u5728\u6211\u8111\u6d77\u4e2d\u6d6e\u73b0\uff1a\u4e5f\u8bb8\u6211\u53ef\u4ee5\u6253\u9020\u4e00\u4e2a\u81ea\u5b66\u5f0f\u7684\u57f9\u517b\u65b9\u6848\uff0c\u628a\u8fd9\u4e09\u5e74\u81ea\u5b66\u4e2d\u9047\u5230\u7684\u5751\u3001\u8d70\u8fc7\u7684\u8def\u8bb0\u5f55\u4e0b\u6765\uff0c\u540c\u65f6\u7ed3\u5408\u5bf9 AI \u65f6\u4ee3\u7684\u601d\u8003\uff0c\u4e3a\u540e\u6765\u7684 CSers \u8d21\u732e\u4e00\u4efd\u5fae\u8584\u4e4b\u529b\u3002</p>"},{"location":"#_4","title":"\u81ea\u5b66\u8fd8\u662f\uff1f","text":"<p>\u81ea\u5b66\u6700\u5927\u7684\u597d\u5904\u5728\u4e8e\u53ef\u4ee5\u5b8c\u5168\u6839\u636e\u81ea\u5df1\u7684\u8fdb\u5ea6\u6765\u8c03\u6574\u5b66\u4e60\u901f\u5ea6\u3002\u4f60\u53ef\u4ee5\u968f\u65f6\u6539\u53d8\u5b66\u4e60\u8ba1\u5212\uff0c\u6309\u7167\u81ea\u5df1\u7684\u8282\u594f\u6765\uff0c\u800c\u4e0d\u662f\u5c40\u9650\u5728\u57f9\u517b\u65b9\u6848\u548c\u8bfe\u5802\u91cc\u3002</p> <p>\u81ea\u5b66\u7684\u53e6\u4e00\u4e2a\u597d\u5904\u662f\u535a\u91c7\u4f17\u957f\u3002\u6211\u7b2c\u4e00\u6b21\u5728\u7b14\u8bb0\u672c\u88c5\u53cc\u7cfb\u7edf\u65f6\u5c31\u72af\u4e86\u9519\uff0c\u628a Windows \u7ed9\u62b9\u6389\u4e86\u3002\u552f\u4e00\u5e86\u5e78\u7684\u662f\u5f53\u65f6\u6ca1\u6709\u4ec0\u4e48\u8d35\u91cd\u8d44\u6599\u3002\u540e\u6765\u53c8\u4e86\u89e3\u5230\u73b0\u4ee3\u56fa\u6001\u786c\u76d8\u4e0d\u4f1a\u5f7b\u5e95\u6d88\u9664\u6570\u636e\uff0c\u53ea\u8981\u65b0\u7cfb\u7edf\u6ca1\u6709\u5360\u7528\u539f\u6709\u78c1\u76d8\u7684\u90a3\u90e8\u5206\u7a7a\u95f4\uff0c\u5c31\u6709\u53ef\u80fd\u6062\u590d\u6570\u636e\u3002\u6b63\u662f\u8fd9\u4e9b\u8bd5\u9519\uff0c\u8ba9\u6211\u4e0d\u65ad\u5b66\u5230\u5404\u79cd\u5e73\u65f6\u63a5\u89e6\u4e0d\u5230\u7684\u77e5\u8bc6\u3002</p> <p>\u81ea\u5b66\u7684\u7b2c\u4e09\u4e2a\u597d\u5904\u662f\u65f6\u95f4\u81ea\u7531\u3002\u5927\u5b66\u672c\u5c31\u76f8\u5bf9\u81ea\u7531\uff0c\u81ea\u5b66\u66f4\u662f\u53ef\u4ee5\u5b89\u6392\u81ea\u5df1\u7684\u5b66\u4e60\u65f6\u95f4\u548c\u8ba1\u5212\u3002\u53ea\u8981\u65f6\u95f4\u5b89\u6392\u5f97\u5f53\uff0c\u4f60\u4ecd\u7136\u80fd\u4e00\u8fb9\u81ea\u5b66\uff0c\u4e00\u8fb9\u53d6\u5f97\u597d\u6210\u7ee9\u3002</p> <p>\u81ea\u5b66\u6709\u4ec0\u4e48\u574f\u5904\u5417\uff1f\u5f53\u7136\uff0c\u51e1\u4e8b\u6709\u5229\u6709\u5f0a\u3002</p> <p>\u7b2c\u4e00\u4e2a\u574f\u5904\u662f\u4e0d\u4fbf\u6c9f\u901a\u3002\u4f60\u9047\u5230\u7684\u95ee\u9898\uff0c\u672a\u5fc5\u6709\u4eba\u9047\u5230\uff0c\u4e5f\u672a\u5fc5\u6709\u4eba\u611f\u5174\u8da3\u3002\u4e0d\u8fc7\uff0c\u5584\u4e8e\u501f\u52a9 Google\u3001StackOverflow \u548c AI \u7b49\u5e73\u53f0\u63d0\u95ee\uff0c\u53ef\u4ee5\u89e3\u51b3 90% \u7684\u95ee\u9898\u3002\u7b2c\u4e8c\u4e2a\u574f\u5904\u662f\u5f88\u591a\u4f18\u8d28\u8bfe\u7a0b\u548c\u8d44\u6e90\u662f\u82f1\u6587\u7684\uff0c\u4f46\u8fd9\u5df2\u7ecf\u4e0d\u662f\u4ec0\u4e48\u5927\u95ee\u9898\u4e86\uff0c\u5982\u4eca\u7ffb\u8bd1\u8f6f\u4ef6\u548c\u63d2\u4ef6\u51e0\u4e4e\u5b8c\u7f8e\u89e3\u51b3\u4e86\u8fd9\u4e2a\u95ee\u9898\u3002\u7b2c\u4e09\u4e2a\uff0c\u4e5f\u662f\u6700\u96be\u7684\u2014\u2014\u81ea\u5f8b\u3002\u6ca1\u6709 DDL \u771f\u662f\u4e00\u4ef6\u53ef\u6015\u7684\u4e8b\uff0c\u968f\u7740\u5b66\u4e60\u5185\u5bb9\u6df1\u5165\uff0c\u96be\u5ea6\u4e5f\u4f1a\u4e0a\u5347\uff0c\u575a\u6301\u5b66\u5b8c\u6574\u4e2a\u8bfe\u7a0b\u662f\u76f8\u5f53\u8650\u7684\u3002\u4f60\u5f97\u6709\u8db3\u591f\u7684\u9a71\u52a8\u529b\u5f3a\u8feb\u81ea\u5df1\u9759\u4e0b\u5fc3\u6765\uff0c\u7406\u89e3\u4e0a\u5343\u884c\u7684\u4ee3\u7801\u6846\u67b6\uff0c\u5fcd\u53d7\u6570\u4e2a\u5c0f\u65f6\u7684 debug \u65f6\u5149\u3002\u800c\u8fd9\u4e00\u5207\uff0c\u6ca1\u6709\u5b66\u5206\uff0c\u6ca1\u6709\u7ee9\u70b9\uff0c\u6ca1\u6709\u8001\u5e08\uff0c\u6ca1\u6709\u540c\u5b66\uff0c\u53ea\u6709\u4e00\u4e2a\u4fe1\u5ff5\u2014\u2014\u4f60\u5728\u53d8\u5f3a\u3002</p>"},{"location":"#_5","title":"\u8fd9\u672c\u4e66\u4e3a\u8c01\u800c\u5199","text":"<p>\u4efb\u4f55\u6709\u5fd7\u4e8e\u5b66\u597d\u7528\u597d\u8ba1\u7b97\u673a\u77e5\u8bc6\u7684\u670b\u53cb\u90fd\u53ef\u4ee5\u53c2\u8003\u8fd9\u672c\u4e66\u3002\u5982\u679c\u4f60\u5df2\u7ecf\u6709\u4e86\u4e00\u5b9a\u7684\u8ba1\u7b97\u673a\u57fa\u7840\uff0c\u53ea\u662f\u5bf9\u67d0\u4e2a\u7279\u5b9a\u9886\u57df\u611f\u5174\u8da3\uff0c\u53ef\u4ee5\u6311\u9009\u611f\u5174\u8da3\u7684\u5185\u5bb9\u8fdb\u884c\u5b66\u4e60\u3002\u5f53\u7136\uff0c\u5982\u679c\u4f60\u50cf\u6211\u5f53\u5e74\u4e00\u6837\u5bf9\u8ba1\u7b97\u673a\u4e00\u65e0\u6240\u77e5\uff0c\u521d\u5165\u5927\u5b66\u6821\u95e8\uff0c\u6211\u5e0c\u671b\u8fd9\u672c\u4e66\u80fd\u6210\u4e3a\u4f60\u7684\u653b\u7565\uff0c\u8ba9\u4f60\u82b1\u6700\u5c11\u7684\u65f6\u95f4\u638c\u63e1\u6240\u9700\u7684\u77e5\u8bc6\u548c\u80fd\u529b\u3002\u67d0\u79cd\u7a0b\u5ea6\u4e0a\uff0c\u8fd9\u672c\u4e66\u66f4\u50cf\u662f\u4e00\u4e2a\u6839\u636e\u6211\u7684\u4f53\u9a8c\u6765\u6392\u5e8f\u7684\u8bfe\u7a0b\u641c\u7d22\u5f15\u64ce\uff0c\u5e2e\u52a9\u5927\u5bb6\u8db3\u4e0d\u51fa\u6237\u4f53\u9a8c\u4f18\u8d28\u8ba1\u7b97\u673a\u8bfe\u7a0b\u3002</p>"},{"location":"#_6","title":"\u7279\u522b\u9e23\u8c22","text":"<p>\u5728\u8fd9\u91cc\uff0c\u6211\u6000\u7740\u5d07\u656c\u4e4b\u5fc3\u771f\u8bda\u5730\u611f\u8c22\u6240\u6709\u5c06\u8bfe\u7a0b\u8d44\u6e90\u65e0\u507f\u5f00\u6e90\u7684\u6559\u6388\u548c\u5f00\u53d1\u8005\u4eec\u3002\u8fd9\u4e9b\u8bfe\u7a0b\u548c\u8d44\u6e90\u503e\u6ce8\u4e86\u4ed6\u4eec\u6570\u5341\u5e74\u6559\u5b66\u7684\u79ef\u6dc0\u548c\u5fc3\u8840\uff0c\u4ed6\u4eec\u5374\u9009\u62e9\u65e0\u79c1\u5730\u8ba9\u6240\u6709\u4eba\u4eab\u53d7\u5230\u5982\u6b64\u9ad8\u8d28\u91cf\u7684 CS \u6559\u80b2\u3002\u6ca1\u6709\u4ed6\u4eec\uff0c\u6211\u7684\u5927\u5b66\u751f\u6d3b\u4e0d\u4f1a\u8fd9\u6837\u5145\u5b9e\u800c\u5feb\u4e50\u3002\u5f88\u591a\u6559\u6388\u5728\u6536\u5230\u6211\u7684\u611f\u8c22\u90ae\u4ef6\u540e\uff0c\u751a\u81f3\u4f1a\u56de\u590d\u4e0a\u767e\u5b57\u7684\u957f\u6587\uff0c\u771f\u7684\u8ba9\u6211\u65e0\u6bd4\u611f\u52a8\u3002\u4ed6\u4eec\u65f6\u523b\u6fc0\u52b1\u7740\u6211\uff1a\u505a\u4e00\u4ef6\u4e8b\uff0c\u5c31\u5f97\u7528\u5fc3\u505a\u597d\uff0c\u65e0\u8bba\u662f\u5b66\u4e60\u3001\u79d1\u7814\uff0c\u8fd8\u662f\u4e3a\u4eba\u3002</p>"},{"location":"#_7","title":"\u52a0\u5165\u8d21\u732e\u8005\u884c\u5217","text":"<p>\u4e00\u4e2a\u4eba\u7684\u529b\u91cf\u7ec8\u7a76\u662f\u6709\u9650\u7684\u3002\u8fd9\u672c\u4e66\u662f\u6211\u5728\u7e41\u91cd\u7684\u79d1\u7814\u4e4b\u4f59\u71ac\u591c\u62bd\u7a7a\u5199\u51fa\u6765\u7684\uff0c\u96be\u514d\u6709\u4e0d\u591f\u5b8c\u5584\u4e4b\u5904\u3002\u53e6\u5916\uff0c\u7531\u4e8e\u6211\u4e2a\u4eba\u505a\u7684\u662f\u8ba1\u7b97\u673a\u5e94\u7528\u65b9\u5411\uff0c\u5f88\u591a\u8bfe\u7a0b\u4fa7\u91cd\u5e94\u7528\u5b9e\u8df5\uff0c\u5bf9\u6570\u5b66\u3001\u7406\u8bba\u8ba1\u7b97\u673a\u3001\u9ad8\u7ea7\u7b97\u6cd5\u76f8\u5173\u7684\u5185\u5bb9\u5219\u76f8\u5bf9\u5c11\u4e9b\u3002\u5982\u679c\u4f60\u5728\u5176\u4ed6\u9886\u57df\u6709\u4e30\u5bcc\u7684\u81ea\u5b66\u7ecf\u5386\u4e0e\u8d44\u6e90\uff0c\u6b22\u8fce\u76f4\u63a5\u5728\u9879\u76ee\u4e2d\u53d1\u8d77 Pull Request\uff0c\u4e5f\u53ef\u4ee5\u901a\u8fc7\u90ae\u4ef6\u8054\u7cfb\u6211\uff08zhangchaowen@stu.scu.edu.cn\uff09\u3002</p>"},{"location":"#_8","title":"\u5173\u4e8e\u4ea4\u6d41\u7fa4","text":"<p>\u672c\u4e66\u652f\u6301\u9875\u9762\u8bc4\u8bba\u529f\u80fd\u3002\u5982\u679c\u4f60\u60f3\u81ea\u5b66\u67d0\u95e8\u8bfe\u7a0b\uff0c\u53ef\u4ee5\u5efa\u7acb\u7fa4\u804a\uff08QQ \u6216\u5fae\u4fe1\u7686\u53ef\uff09\uff0c\u7136\u540e\u5728\u5bf9\u5e94\u8bfe\u7a0b\u9875\u9762\u4e0b\u65b9\u53d1\u8868\u8bc4\u8bba\uff0c\u6ce8\u660e\u5b66\u4e60\u76ee\u6807\u548c\u52a0\u5165\u65b9\u5f0f\u3002\u6b64\u5916\uff0c\u8fc7\u53bb\u5df2\u6709\u4e0d\u5c11\u670b\u53cb\u5728 Issue \u4e2d\u5efa\u7acb\u4e86\u4ea4\u6d41\u7fa4\uff0c\u53ef\u4ee5\u76f4\u63a5\u52a0\u5165\u3002</p>"},{"location":"#_9","title":"\u8bf7\u4f5c\u8005\u559d\u676f\u4e0b\u5348\u8336","text":"<p>\u672c\u4e66\u5185\u5bb9\u5b8c\u5168\u5f00\u6e90\u514d\u8d39\u3002\u5982\u679c\u4f60\u89c9\u5f97\u8fd9\u4e2a\u9879\u76ee\u5bf9\u4f60\u6709\u5e2e\u52a9\uff0c\u53ef\u4ee5\u7ed9\u4ed3\u5e93\u70b9\u4e2a star\uff0c\u6216\u8005\u8bf7\u4f5c\u8005\u559d\u4e00\u676f\u4e0b\u5348\u8336\u3002</p> <p></p>"},{"location":"AI-CS%E5%AD%A6%E4%B9%A0%E8%A7%84%E5%88%92/","title":"\u4e00\u4efd\u4ec5\u4f9b\u53c2\u8003\u7684\u5b66\u4e60\u89c4\u5212","text":""},{"location":"%E4%BD%BF%E7%94%A8%E6%8C%87%E5%8D%97/","title":"\u5982\u4f55\u4f7f\u7528\u8fd9\u672c\u4e66","text":"<p>\u968f\u7740\u8d21\u732e\u8005\u7684\u4e0d\u65ad\u589e\u591a\uff0c\u672c\u4e66\u7684\u5185\u5bb9\u4e5f\u4e0d\u65ad\u6269\u5c55\uff0c\u60f3\u628a\u4e66\u4e2d\u6240\u6709\u7684\u8bfe\u7a0b\u5168\u90e8\u5b66\u5b8c\u662f\u4e0d\u5207\u5b9e\u9645\u4e5f\u6ca1\u6709\u5fc5\u8981\u7684\uff0c\u751a\u81f3\u4f1a\u8d77\u5230\u4e8b\u500d\u529f\u534a\u7684\u53cd\u6548\u679c\uff0c\u5403\u529b\u800c\u4e0d\u8ba8\u597d\u3002\u4e3a\u4e86\u66f4\u597d\u5730\u8d34\u5408\u8bfb\u8005\uff0c\u8ba9\u8fd9\u672c\u4e66\u771f\u6b63\u4e3a\u4f60\u6240\u7528\uff0c\u6211\u5c06\u8bfb\u8005\u6309\u7167\u9700\u6c42\u5927\u81f4\u5206\u4e3a\u4e86\u5982\u4e0b\u4e09\u7c7b\uff0c\u5927\u5bb6\u53ef\u4ee5\u7ed3\u5408\u5207\u8eab\u5b9e\u9645\uff0c\u7cbe\u51c6\u5730\u89c4\u5212\u5c5e\u4e8e\u81ea\u5df1\u7684\u81ea\u5b66\u65b9\u6848\u3002</p>"},{"location":"%E4%BD%BF%E7%94%A8%E6%8C%87%E5%8D%97/#_2","title":"\u521d\u5165\u6821\u56ed","text":"<p>\u5982\u679c\u4f60\u521a\u521a\u8fdb\u5165\u5927\u5b66\u6821\u56ed\u6216\u8005\u8fd8\u5728\u4f4e\u5e74\u7ea7\uff0c\u5e76\u4e14\u5c31\u8bfb\u7684\u662f\u8ba1\u7b97\u673a\u65b9\u5411\u6216\u8005\u60f3\u8981\u8f6c\u5230\u8ba1\u7b97\u673a\u65b9\u5411\uff0c\u90a3\u4e48\u4f60\u5f88\u5e78\u8fd0\uff0c\u56e0\u4e3a\u5b66\u4e60\u662f\u4f60\u7684\u672c\u4e1a\uff0c\u4f60\u53ef\u4ee5\u6709\u5145\u8db3\u7684\u65f6\u95f4\u548c\u81ea\u7531\u6765\u5b66\u4e60\u81ea\u5df1\u611f\u5174\u8da3\u7684\u4e1c\u897f\uff0c\u4e0d\u4f1a\u6709\u5de5\u4f5c\u7684\u538b\u529b\u548c\u751f\u6d3b\u7684\u7410\u788e\uff0c\u4e0d\u5fc5\u8fc7\u4e8e\u7ea0\u7ed3\u201c\u5b66\u4e86\u6709\u6ca1\u6709\u7528\u201d\uff0c\u201c\u80fd\u4e0d\u80fd\u627e\u5230\u5de5\u4f5c\u201d\u8fd9\u7c7b\u529f\u5229\u7684\u60f3\u6cd5\u3002\u90a3\u4e48\u8be5\u5982\u4f55\u5b89\u6392\u5927\u5b66\u7684\u5b66\u4e60\u751f\u6d3b\u5462\uff1f\u6211\u8ba4\u4e3a\u9996\u8981\u4e00\u70b9\u5c31\u662f\u6253\u7834\u9ad8\u4e2d\u6309\u90e8\u5c31\u73ed\u7684\u5b66\u4e60\u751f\u6d3b\u65b9\u5f0f\u3002\u5927\u5b66\u662f\u81ea\u7531\u7684\uff0c\u65e0\u8bba\u662f\u751f\u6d3b\u8fd8\u662f\u5b66\u4e60\uff0c\u5c3d\u7ba1\u4ecd\u7136\u6709\u8bfe\u5802\u3001\u8003\u8bd5\uff0c\u4f46\u5374\u5e76\u975e\u53ea\u9700\u5237\u9898\u4fbf\u80fd\u6210\u529f\u3002\u9996\u5148\uff0c\u5728\u5927\u5b66\u91cc\uff0c\u4f60\u53ef\u4ee5\u4e0d\u5c40\u9650\u4e8e\u8bfe\u672c\u6216\u8bfe\u5802\u4e0a\u7684\u77e5\u8bc6\uff0c\u5373\u4f7f\u5728\u4f60\u7684\u4e13\u4e1a\u9886\u57df\uff0c\u4f60\u4e5f\u53ef\u4ee5\u6269\u5c55\u5b66\u4e60\u5404\u79cd\u77e5\u8bc6\uff0c\u9664\u6b64\u4ee5\u5916\uff0c\u4f60\u66f4\u53ef\u4ee5\u8de8\u4e13\u4e1a\u5b66\u4e60\u77e5\u8bc6\uff1b\u5176\u6b21\uff0c\u6211\u5e0c\u671b\u4f60\u80fd\u5c11\u4e9b\u529f\u5229\u5fc3\uff0c\u6709\u76ee\u6807\uff08\u4fdd\u7814\u3001\u5c31\u4e1a\u3001\u51fa\u56fd\u7559\u5b66\u7b49\uff09\u662f\u597d\u4e8b\uff0c\u4f46\u505a\u4e8b\u4e0d\u8981\u4ec5\u4ec5\u4e3a\u4e86\u8fbe\u5230\u8fd9\u4e9b\u76ee\u6807\uff0c\u66f4\u5e94\u8be5\u5c3d\u529b\u5728\u8fc7\u7a0b\u4e2d\u5b66\u5230\u80fd\u4f34\u968f\u4f60\u4e00\u751f\u7684\u77e5\u8bc6\uff0c\u5b83\u4eec\u6216\u8bb8\u662f\u5b66\u4e60\u65b9\u6cd5\u3001\u6216\u8bb8\u662f\u4e00\u79cd\u505a\u4e8b\u65b9\u6cd5\uff0c\u4f46\u5c11\u4e9b\u529f\u5229\u5fc3\u4e0d\u5e94\u8be5\u6210\u4e3a\u4f60\u5077\u61d2\u653e\u7eb5\u7684\u501f\u53e3\uff1b\u6700\u540e\uff0c\u5e73\u8861\u597d\u5b66\u4e60\u548c\u751f\u6d3b\uff0c\u5b66\u4e60\u5e94\u8be5\u662f\u751f\u6d3b\u7684\u4e00\u90e8\u5206\uff0c\u6211\u672c\u79d1\u65f6\u53c2\u52a0\u8fc7\u4e00\u4e2a\u793e\u56e2\uff0c\u91cc\u9762\u6709\u4e00\u4e9b\u8fd1\u4e4e\u75af\u72c2\u7684\u4eba\uff0c\u4ed6\u4eec\u751a\u81f3\u6bcf\u5929\u665a\u4e0a\u5728\u793e\u56e2\u573a\u5730\u4e2d\u6253\u5730\u94fa\uff0c\u6211\u4e0d\u8ba4\u4e3a\u8fd9\u662f\u771f\u5fc3\u70ed\u7231\u77e5\u8bc6\u7684\u8868\u73b0\uff0c\u76f8\u53cd\u662f\u4ed6\u4eec\u5728\u751f\u6d3b\u4e0a\u4e0d\u591f\u6210\u719f\u7684\u8868\u73b0\u3002</p> <p>\u672c\u4e66\u6db5\u76d6\u8ba1\u7b97\u673a\u9886\u57df\u5404\u65b9\u9762\u7684\u77e5\u8bc6\uff0c\u6211\u5efa\u8bae\u4f60\u6839\u636e\u57f9\u517b\u65b9\u6848\u9009\u62e9\u5f53\u524d\u5b66\u5e74\u5bf9\u5e94\u7684\u8bfe\u7a0b\u5b66\u4e60\uff0c\u540c\u65f6\u5728\u8bfe\u4f59\u53ef\u4ee5\u9009\u62e9\u4e00\u4e9b\u8bfe\u5802\u6ca1\u6709\u7684\u8bfe\u7a0b\u52a0\u4ee5\u6269\u5c55\uff0c\u5c24\u5176\u662f\u4e00\u4e9b\u4f7f\u7528\u5de5\u5177\u548c\u6280\u672f\uff0c\u4f8b\u5982git\u3001docker\u3001vue\u7b49\u3002\u5c31\u76ee\u524d\u800c\u8a00\uff0c\u56fd\u5185\u7684\u8ba1\u7b97\u673a\u6559\u5b66\u4e0d\u4f1a\u6559\u6388\u592a\u591a\u5b9e\u8df5\u77e5\u8bc6\uff0c\u800c\u5b9e\u8df5\u662f\u672c\u4e13\u4e1a\u6700\u91cd\u8981\u7684\u5b66\u4e60\u8fc7\u7a0b\uff0c\u6240\u4ee5\u4f60\u5927\u6982\u7387\u53ea\u80fd\u9760\u81ea\u5df1\u52a8\u624b\u5b9e\u8df5\uff0c\u9010\u6e10\u79ef\u7d2f\u7ecf\u9a8c\u3002</p> <p>\u7b2c\u4e00\u4ef6\u4e8b\uff0c\u662f\u5f04\u6e05\u695a\u4ec0\u4e48\u53eb\u201c\u5199\u5f97\u4f18\u96c5\u201d\u7684\u4ee3\u7801\u3002\u56fd\u5185\u4e0d\u5c11\u5927\u4e00\u7f16\u7a0b\u5165\u95e8\u8bfe\u5bb9\u6613\u4e0a\u6210\u67af\u71e5\u7684\u8bed\u6cd5\u7f57\u5217\uff0c\u6548\u679c\u751a\u81f3\u4e0d\u5982\u8ba9\u5b66\u751f\u81ea\u5df1\u8bfb\u5b98\u65b9\u6587\u6863\u3002\u5176\u5b9e\u521a\u63a5\u89e6\u7f16\u7a0b\u65f6\uff0c\u5c31\u53bb\u611f\u53d7\u4ec0\u4e48\u6837\u7684\u4ee3\u7801\u7b97\u4f18\u96c5\u3001\u4ec0\u4e48\u6837\u7684\u4ee3\u7801\u201chave bad taste\u201d\uff0c\u662f\u5f88\u6709\u5e2e\u52a9\u7684\u3002\u5165\u95e8\u9636\u6bb5\u901a\u5e38\u4f1a\u5148\u8bb2\u8fc7\u7a0b\u5f0f\u7f16\u7a0b\uff0c\u6bd4\u5982 C \u8bed\u8a00\uff0c\u4f46\u5373\u4fbf\u662f\u9762\u5411\u8fc7\u7a0b\uff0c\u6a21\u5757\u5316\u3001\u5c01\u88c5\u8fd9\u4e9b\u610f\u8bc6\u4e5f\u4e0d\u80fd\u4e22\u3002\u5982\u679c\u5199\u4ee3\u7801\u65f6\u53ea\u60f3\u7740\u5728 OpenJudge \u4e0a\u901a\u8fc7\uff0c\u56fe\u7701\u4e8b\u9760\u590d\u5236\u7c98\u8d34\u5806\u51fa\u4e00\u4e2a\u5e9e\u5927\u7684 main \u51fd\u6570\uff0c\u65f6\u95f4\u4e00\u957f\uff0c\u4ee3\u7801\u8d28\u91cf\u5c31\u5f88\u5bb9\u6613\u505c\u5728\u8fd9\u4e2a\u6c34\u5e73\u3002\u7b49\u78b0\u5230\u7a0d\u5fae\u5927\u4e00\u70b9\u7684\u9879\u76ee\uff0c\u8c03\u8bd5\u3001\u6c9f\u901a\u548c\u7ef4\u62a4\u7684\u6210\u672c\u4f1a\u50cf\u6eda\u96ea\u7403\u4e00\u6837\u538b\u8fc7\u6765\u3002\u6240\u4ee5\u5199\u7684\u65f6\u5019\u4e0d\u59a8\u591a\u95ee\u81ea\u5df1\u51e0\u53e5\uff1a\u6709\u6ca1\u6709\u5927\u91cf\u91cd\u590d\uff1f\u8fd9\u4e2a\u51fd\u6570\u662f\u4e0d\u662f\u627f\u62c5\u4e86\u592a\u591a\u804c\u8d23\uff1fLinux \u7684\u98ce\u683c\u5c31\u662f\u8ba9\u4e00\u4e2a\u51fd\u6570\u53ea\u505a\u597d\u4e00\u4ef6\u4e8b\u3002\u8fd9\u6bb5\u903b\u8f91\u80fd\u4e0d\u80fd\u62bd\u6210\u72ec\u7acb\u51fd\u6570\uff1f\u521a\u5f00\u59cb\u53ef\u80fd\u4f1a\u89c9\u5f97\u522b\u626d\uff0c\u751a\u81f3\u6000\u7591\u4e00\u9053\u7b80\u5355\u9898\u4f55\u5fc5\u8fd9\u4e48\u6298\u817e\uff0c\u4f46\u597d\u4e60\u60ef\u7684\u4ef7\u503c\u662f\u957f\u671f\u7684\u3002C \u8bed\u8a00\u672c\u8eab\u5e76\u4e0d\u96be\uff0c\u521d\u4e2d\u751f\u90fd\u80fd\u5b66\uff0c\u90a3\u516c\u53f8\u51ed\u4ec0\u4e48\u8981\u62db\u4f60\u6765\u505a\u7a0b\u5e8f\u5458\uff1f</p> <p>\u5b66\u8fc7\u9762\u5411\u8fc7\u7a0b\u4e4b\u540e\uff0c\u5927\u4e00\u4e0b\u5b66\u671f\u901a\u5e38\u4f1a\u8f6c\u5411\u9762\u5411\u5bf9\u8c61\uff0c\u6bd4\u5982 C++ \u6216 Java\u3002\u8fd9\u91cc\u5f88\u63a8\u8350 MIT 6.031: Software Construction \u7684 Notes\uff0c\u5b83\u4f1a\u4ee5 Java\uff082022 \u5e74\u6539\u6210\u4e86 TypeScript\uff09\u4e3a\u4f8b\uff0c\u7ec6\u81f4\u8bb2\u600e\u4e48\u5199\u51fa\u66f4\u4f18\u96c5\u7684\u4ee3\u7801\uff0c\u6bd4\u5982\u6d4b\u8bd5\u9a71\u52a8\u5f00\u53d1\u3001\u51fd\u6570\u89c4\u683c\u8bf4\u660e\u7684\u8bbe\u8ba1\u3001\u5f02\u5e38\u5904\u7406\u7b49\u3002\u65e2\u7136\u63a5\u89e6\u4e86\u9762\u5411\u5bf9\u8c61\uff0c\u4e86\u89e3\u4e00\u4e9b\u5e38\u89c1\u8bbe\u8ba1\u6a21\u5f0f\u4e5f\u5f88\u6709\u5fc5\u8981\u3002\u56fd\u5185\u9762\u5411\u5bf9\u8c61\u8bfe\u7a0b\u6709\u65f6\u4e5f\u5bb9\u6613\u53d8\u6210\u8bed\u6cd5\u8bfe\uff0c\u8ba9\u5b66\u751f\u7ea0\u7ed3\u7ee7\u627f\u7684\u5404\u79cd\u5199\u6cd5\uff0c\u751a\u81f3\u505a\u7c7b\u4f3c\u8111\u7b4b\u6025\u8f6c\u5f2f\u7684\u9898\u76ee\uff0c\u4f46\u8fd9\u4e9b\u4e1c\u897f\u5728\u771f\u5b9e\u9879\u76ee\u91cc\u51e0\u4e4e\u7528\u4e0d\u4e0a\u3002\u9762\u5411\u5bf9\u8c61\u771f\u6b63\u8981\u7ec3\u7684\uff0c\u662f\u628a\u5b9e\u9645\u95ee\u9898\u62bd\u8c61\u6210\u82e5\u5e72\u7c7b\u4ee5\u53ca\u5b83\u4eec\u4e4b\u95f4\u7684\u5173\u7cfb\uff1b\u8bbe\u8ba1\u6a21\u5f0f\u5219\u662f\u524d\u4eba\u603b\u7ed3\u51fa\u6765\u7684\u4e00\u4e9b\u62bd\u8c61\u7ecf\u9a8c\u3002\u300a\u5927\u8bdd\u8bbe\u8ba1\u6a21\u5f0f\u300b\u8fd9\u672c\u4e66\u5c31\u5199\u5f97\u6bd4\u8f83\u6d45\u663e\u6613\u61c2\uff0c\u9002\u5408\u5165\u95e8\u3002</p> <p>\u7b2c\u4e8c\u4ef6\u4e8b\uff0c\u662f\u5b66\u4e00\u4e9b\u80fd\u660e\u663e\u63d0\u5347\u751f\u4ea7\u529b\u7684\u5de5\u5177\u548c\u6280\u80fd\uff0c\u6bd4\u5982 Git\u3001Shell\u3001Vim\u3002\u8fd9\u91cc\u5f3a\u70c8\u63a8\u8350 MIT missing semester\u3002\u521a\u4e0a\u624b\u53ef\u80fd\u5f88\u4e0d\u4e60\u60ef\uff0c\u4f46\u903c\u81ea\u5df1\u7528\u4e00\u6bb5\u65f6\u95f4\uff0c\u719f\u7ec3\u540e\u5f00\u53d1\u6548\u7387\u4f1a\u660e\u663e\u4e0a\u4e00\u4e2a\u53f0\u9636\u3002\u8fd8\u6709\u5f88\u591a\u5c0f\u5de5\u5177\u4e5f\u80fd\u63d0\u5347\u6548\u7387\u3002\u6211\u81ea\u5df1\u7684\u4e00\u4e2a\u539f\u5219\u662f\uff1a\u51e1\u662f\u4f1a\u8ba9\u624b\u79bb\u5f00\u952e\u76d8\u7684\u52a8\u4f5c\uff0c\u90fd\u503c\u5f97\u60f3\u529e\u6cd5\u7701\u6389\u3002\u5207\u6362\u5e94\u7528\u3001\u6253\u5f00\u6587\u4ef6\u3001\u6d4f\u89c8\u7f51\u9875\uff0c\u90fd\u53ef\u4ee5\u7528\u63d2\u4ef6\u6216\u5de5\u5177\u505a\u6210\u5feb\u6377\u64cd\u4f5c\uff0cMac \u4e0a\u6bd4\u5982 Alfred\u3002\u5982\u679c\u4e00\u4e2a\u64cd\u4f5c\u6bcf\u5929\u90fd\u91cd\u590d\uff0c\u800c\u4e14\u6bcf\u6b21\u8fd8\u8981\u82b1\u4e00\u79d2\u4ee5\u4e0a\uff0c\u90a3\u5c31\u60f3\u529e\u6cd5\u628a\u5b83\u538b\u5230 0.1 \u79d2\u3002\u6bd5\u7adf\u4ee5\u540e\u51e0\u5341\u5e74\u90fd\u8981\u548c\u7535\u8111\u6253\u4ea4\u9053\uff0c\u65e9\u70b9\u5f62\u6210\u987a\u6ed1\u7684\u5de5\u4f5c\u6d41\u4f1a\u7701\u5f88\u591a\u529b\u3002\u53e6\u5916\uff0c\u76f2\u6253\u4e00\u5b9a\u8981\u7ec3\u3002\u5982\u679c\u73b0\u5728\u8fd8\u8981\u770b\u7740\u952e\u76d8\u6253\u5b57\uff0c\u8d76\u7d27\u627e\u4e2a\u6559\u7a0b\u7ec3\u8d77\u6765\uff0c\u8fd9\u5bf9\u5f00\u53d1\u6548\u7387\u5e2e\u52a9\u5f88\u5927\u3002</p> <p>\u7b2c\u4e09\u4ef6\u4e8b\uff0c\u662f\u5e73\u8861\u597d\u8bfe\u5185\u548c\u81ea\u5b66\u3002\u53ef\u4ee5\u8d28\u7591\u73b0\u72b6\uff0c\u4f46\u89c4\u5219\u8fd8\u662f\u8981\u5c0a\u91cd\uff0c\u5c24\u5176\u7ee9\u70b9\u5728\u4fdd\u7814\u91cc\u5206\u91cf\u4e0d\u8f7b\u3002\u6240\u4ee5\u5927\u4e00\u6211\u8fd8\u662f\u5efa\u8bae\u5c3d\u91cf\u8ddf\u7740\u8bfe\u8868\u8d70\uff0c\u540c\u65f6\u8f85\u4ee5\u4f18\u8d28\u8bfe\u5916\u8d44\u6e90\u3002\u6bd4\u5982\u5fae\u79ef\u5206\u3001\u7ebf\u4ee3\u53ef\u4ee5\u53c2\u8003 MIT 18.01/18.02 \u548c MIT 18.06 \u7684\u8bfe\u7a0b Notes\uff1b\u5047\u671f\u53ef\u4ee5\u7528 UCB CS61A \u5b66 Python\u3002\u540c\u65f6\u628a\u524d\u9762\u8bf4\u7684\u7f16\u7a0b\u4e60\u60ef\u548c\u5b9e\u8df5\u80fd\u529b\u6162\u6162\u7ec3\u8d77\u6765\u3002\u5c31\u4e2a\u4eba\u7ecf\u9a8c\u770b\uff0c\u5927\u4e00\u6570\u5b66\u8bfe\u5b66\u5206\u5360\u6bd4\u9ad8\uff0c\u8003\u8bd5\u98ce\u683c\u53c8\u56e0\u5b66\u6821\u548c\u8001\u5e08\u5dee\u5f02\u5f88\u5927\u3002\u81ea\u5b66\u53ef\u80fd\u5e2e\u4f60\u7406\u89e3\u6570\u5b66\u672c\u8eab\uff0c\u5374\u4e0d\u4e00\u5b9a\u80fd\u6362\u6765\u6f02\u4eae\u5206\u6570\u3002\u6240\u4ee5\u8003\u524d\u6700\u597d\u6709\u9488\u5bf9\u6027\u5730\u505a\u5f80\u5e74\u9898\uff0c\u628a\u5e94\u8bd5\u8fd9\u4e00\u73af\u8865\u4e0a\u3002\u5347\u5165\u5927\u4e8c\u4e4b\u540e\uff0c\u518d\u9010\u6b65\u52a0\u5927\u81ea\u5b66\u6bd4\u91cd\uff0c\u53ef\u80fd\u4f1a\u66f4\u7a33\u59a5\u3002</p> <p>\u5927\u4e8c\u4ee5\u540e\uff0c\u8ba1\u7b97\u673a\u4e13\u4e1a\u7684\u8bfe\u7a0b\u4f1a\u9010\u6e10\u591a\u8d77\u6765\uff0c\u8fd9\u65f6\u5019\u5176\u5b9e\u5f88\u9002\u5408\u628a\u5b66\u4e60\u91cd\u5fc3\u5f80\u81ea\u5b66\u4e0a\u632a\u4e00\u632a\u3002\u6211\u628a\u81ea\u5df1\u4e09\u5e74\u6765\u81ea\u5b66\u7684\u8def\u7ebf\u6574\u7406\u6210\u4e86\u4e00\u4efd CS \u5b66\u4e60\u6e05\u5355\uff0c\u91cc\u9762\u7b80\u5355\u5199\u4e86\u6bcf\u95e8\u8bfe\u5927\u6982\u8bb2\u4ec0\u4e48\u3001\u4e3a\u4ec0\u4e48\u503c\u5f97\u5b66\u3002\u4f60\u8bfe\u8868\u4e0a\u7684\u5927\u90e8\u5206\u8bfe\u7a0b\uff0c\u57fa\u672c\u90fd\u80fd\u5728\u8fd9\u4efd\u6e05\u5355\u91cc\u627e\u5230\u5bf9\u5e94\u7684\u56fd\u5916\u8bfe\u7a0b\uff0c\u800c\u4e14\u6574\u4f53\u8d28\u91cf\u901a\u5e38\u66f4\u624e\u5b9e\u3002\u8ba1\u7b97\u673a\u4e13\u4e1a\u7684\u6838\u5fc3\u77e5\u8bc6\u672c\u6765\u5c31\u76f8\u901a\uff0c\u597d\u7684\u8bfe\u7a0b\u5f80\u5f80\u80fd\u628a\u539f\u7406\u8bb2\u900f\uff0c\u76f8\u6bd4\u4e4b\u4e0b\uff0c\u4e0d\u5c11\u7167\u672c\u5ba3\u79d1\u5f0f\u7684\u8bfe\u5802\u5c31\u5f88\u96be\u505a\u5230\u8fd9\u4e00\u70b9\u3002\u4e00\u822c\u6765\u8bf4\uff0c\u8003\u524d\u628a\u8001\u5e08\u8bb2\u4e86\u4e00\u5b66\u671f\u7684 PPT \u62ff\u51fa\u6765\u96c6\u4e2d\u590d\u4e60\u4e24\u5929\uff0c\u5377\u9762\u6210\u7ee9\u901a\u5e38\u4e0d\u4f1a\u592a\u96be\u770b\u3002\u5982\u679c\u8bfe\u7a0b\u6709\u5927\u4f5c\u4e1a\uff0c\u4e5f\u53ef\u4ee5\u628a\u56fd\u5916\u8bfe\u7a0b\u7684 Lab \u6216 Project \u62ff\u6765\u6539\u4e00\u6539\uff0c\u5e94\u4ed8\u8bfe\u5185\u8981\u6c42\u3002\u603b\u4e4b\uff0c\u5173\u952e\u662f\u8981\u7075\u6d3b\uff1a\u76ee\u6807\u662f\u66f4\u9ad8\u6548\u5730\u638c\u63e1\u77e5\u8bc6\uff0c\u9047\u5230\u548c\u8fd9\u4e2a\u76ee\u6807\u51b2\u7a81\u7684\u89c4\u5b9a\uff0c\u53ef\u4ee5\u60f3\u529e\u6cd5\u7ed5\u5f00\u6216\u7b80\u5316\u5904\u7406\u3002</p> <p>\u6700\u540e\uff0c\u8fd8\u662f\u5e0c\u671b\u5927\u5bb6\u5c11\u4e00\u70b9\u6d6e\u8e81\u548c\u529f\u5229\uff0c\u591a\u4e00\u70b9\u8010\u5fc3\u548c\u771f\u6b63\u7684\u5174\u8da3\u3002\u5f88\u591a\u4eba\u95ee\u6211\uff0c\u81ea\u5b66\u662f\u4e0d\u662f\u7279\u522b\u9700\u8981\u81ea\u5236\u529b\u3002\u6211\u89c9\u5f97\u5173\u952e\u8fd8\u662f\u770b\u4f60\u81ea\u5df1\u60f3\u8981\u4ec0\u4e48\u3002\u5982\u679c\u4f60\u53ea\u662f\u89c9\u5f97\u5b66\u4f1a\u4e00\u95e8\u7f16\u7a0b\u8bed\u8a00\u5c31\u80fd\u6708\u85aa\u8fc7\u4e07\uff0c\u60f3\u8d76\u4e0a\u4e92\u8054\u7f51\u7ea2\u5229\uff0c\u90a3\u6211\u8bf4\u518d\u591a\u4e5f\u6ca1\u7528\u3002\u6211\u6700\u521d\u81ea\u5b66\u5176\u5b9e\u6ca1\u60f3\u592a\u591a\u529f\u5229\u7684\u4e1c\u897f\uff0c\u66f4\u591a\u662f\u597d\u5947\uff0c\u662f\u60f3\u5f04\u660e\u767d\u4e00\u4e9b\u4e1c\u897f\u3002\u6574\u4e2a\u8fc7\u7a0b\u4e5f\u6ca1\u6709\u60f3\u8c61\u4e2d\u90a3\u4e48\u82e6\u5927\u4ec7\u6df1\uff0c\u8be5\u5403\u5403\u3001\u8be5\u73a9\u73a9\uff0c\u56de\u5934\u4e00\u770b\uff0c\u8d44\u6599\u53cd\u800c\u6162\u6162\u6512\u4e86\u4e0d\u5c11\u3002\u73b0\u5728\u4e2d\u7f8e\u7ade\u4e89\u5df2\u7ecf\u662f\u4e00\u4e2a\u5927\u80cc\u666f\uff0c\u6211\u4eec\u8fd8\u5728\u5b66\u4e60\u56fd\u5916\u7684\u9ad8\u8d28\u91cf\u8bfe\u7a0b\uff0c\u611f\u53f9\u522b\u4eba\u505a\u5f97\u597d\uff0c\u540c\u65f6\u4e5f\u4f1a\u6709\u4e00\u70b9\u5371\u673a\u611f\u3002\u90a3\u4ee5\u540e\u9760\u8c01\u53bb\u6539\u53d8\u5462\uff1f\u8fd8\u662f\u8981\u9760\u521a\u5165\u884c\u7684\u4f60\u4eec\u3002\u6240\u4ee5\uff0c\u52a0\u6cb9\u5427\uff0c\u5c11\u5e74\u3002</p>"},{"location":"%E4%BD%BF%E7%94%A8%E6%8C%87%E5%8D%97/#_3","title":"\u53bb\u829c\u5b58\u83c1","text":"<p>\u5982\u679c\u4f60\u5df2\u7ecf\u672c\u79d1\u6bd5\u4e1a\u3001\u6b63\u5728\u8bfb\u7814\uff0c\u6216\u8005\u5df2\u7ecf\u5de5\u4f5c\uff0c\u751a\u81f3\u662f\u5728\u5176\u4ed6\u9886\u57df\u4e0a\u73ed\u3001\u60f3\u5229\u7528\u4e1a\u4f59\u65f6\u95f4\u8f6c\u5411\u7f16\u7a0b\uff0c\u90a3\u4e48\u4f60\u5927\u6982\u5f88\u96be\u6324\u51fa\u8db3\u591f\u65f6\u95f4\uff0c\u628a\u201c\u4e00\u4efd\u4ec5\u4f9b\u53c2\u8003\u7684CS\u5b66\u4e60\u89c4\u5212\u201d\u91cc\u7684\u5185\u5bb9\u4ece\u5934\u5230\u5c3e\u7cfb\u7edf\u5b66\u4e00\u904d\uff1b\u4f46\u4f60\u53c8\u786e\u5b9e\u60f3\u8865\u4e0a\u672c\u79d1\u9636\u6bb5\u6b20\u4e0b\u7684\u57fa\u7840\u3002\u8003\u8651\u5230\u8fd9\u7c7b\u8bfb\u8005\u901a\u5e38\u5df2\u6709\u4e00\u5b9a\u7f16\u7a0b\u7ecf\u9a8c\uff0c\u5165\u95e8\u8bfe\u7a0b\u5c31\u4e0d\u5fc5\u518d\u91cd\u590d\u4e86\u3002\u4ece\u5b9e\u7528\u89d2\u5ea6\u770b\uff0c\u5de5\u4f5c\u65b9\u5411\u5927\u4f53\u5df2\u5b9a\uff0c\u4e5f\u6ca1\u5fc5\u8981\u628a\u8ba1\u7b97\u673a\u7684\u6bcf\u4e2a\u5206\u652f\u90fd\u94bb\u5f97\u5f88\u6df1\uff0c\u66f4\u503c\u5f97\u6295\u5165\u7684\u662f\u90a3\u4e9b\u901a\u7528\u6027\u5f3a\u7684\u539f\u5219\u548c\u6280\u80fd\u3002\u56e0\u6b64\uff0c\u6211\u7ed3\u5408\u81ea\u5df1\u7684\u7ecf\u5386\uff0c\u6311\u4e86\u51e0\u95e8\u6211\u8ba4\u4e3a\u6700\u91cd\u8981\u3001\u8d28\u91cf\u4e5f\u6700\u9ad8\u7684\u6838\u5fc3\u4e13\u4e1a\u8bfe\uff0c\u5e0c\u671b\u80fd\u5e2e\u52a9\u4f60\u66f4\u6df1\u5165\u5730\u7406\u89e3\u8ba1\u7b97\u673a\u3002\u5b66\u5b8c\u8fd9\u4e9b\u8bfe\uff0c\u4e0d\u7ba1\u4f60\u5177\u4f53\u505a\u4ec0\u4e48\u5de5\u4f5c\uff0c\u5e94\u8be5\u90fd\u4e0d\u81f3\u4e8e\u53ea\u505c\u7559\u5728\u4f1a\u8c03\u5305\u7684\u6c34\u5e73\uff0c\u800c\u662f\u4f1a\u5bf9\u8ba1\u7b97\u673a\u5e95\u5c42\u5982\u4f55\u8fd0\u884c\u6709\u66f4\u6e05\u695a\u7684\u8ba4\u8bc6\u3002</p>"},{"location":"%E4%BD%BF%E7%94%A8%E6%8C%87%E5%8D%97/#_4","title":"\u68a6\u6709\u6240\u6258","text":"<p>\u5982\u679c\u4f60\u5bf9\u4e8e\u8ba1\u7b97\u673a\u9886\u57df\u7684\u6838\u5fc3\u4e13\u4e1a\u8bfe\u90fd\u638c\u63e1\u5f97\u76f8\u5f53\u624e\u5b9e\uff0c\u800c\u4e14\u5df2\u7ecf\u786e\u5b9a\u4e86\u81ea\u5df1\u7684\u5de5\u4f5c\u6216\u7814\u7a76\u65b9\u5411\uff0c\u90a3\u4e48\u4e66\u4e2d\u8fd8\u6709\u5f88\u591a\u672a\u5728 \u4e00\u4efd\u4ec5\u4f9b\u53c2\u8003\u7684CS\u5b66\u4e60\u89c4\u5212 \u63d0\u5230\u7684\u8bfe\u7a0b\u4f9b\u4f60\u63a2\u7d22\u3002</p> <p>\u968f\u7740\u8d21\u732e\u8005\u7684\u4e0d\u65ad\u589e\u591a\uff0c\u5de6\u4fa7\u7684\u76ee\u5f55\u4e2d\u5c06\u4e0d\u65ad\u589e\u52a0\u65b0\u7684\u5206\u652f\uff0c\u4f8b\u5982 \u673a\u5668\u5b66\u4e60\u8fdb\u9636 \u548c \u673a\u5668\u5b66\u4e60\u7cfb\u7edf\u3002\u5e76\u4e14\u540c\u4e00\u4e2a\u5206\u652f\u4e0b\u90fd\u6709\u82e5\u5e72\u540c\u7c7b\u578b\u8bfe\u7a0b\uff0c\u5b83\u4eec\u6709\u7740\u4e0d\u540c\u7684\u4fa7\u91cd\u70b9\u548c\u8bfe\u7a0b\u5b9e\u9a8c\uff0c\u4f8b\u5982 \u64cd\u4f5c\u7cfb\u7edf \u5206\u652f\u4e0b\u5c31\u5305\u542b\u4e86\u9ebb\u7701\u7406\u5de5\u3001\u4f2f\u514b\u5229\u3001\u5357\u4eac\u5927\u5b66\u8fd8\u6709\u54c8\u5de5\u5927\u56db\u6240\u5b66\u6821\u7684\u8bfe\u7a0b\u3002\u5982\u679c\u4f60\u60f3\u6df1\u8015\u4e00\u4e2a\u9886\u57df\uff0c\u90a3\u4e48\u5b66\u4e60\u8fd9\u4e9b\u540c\u7c7b\u7684\u8bfe\u7a0b\u4f1a\u7ed9\u4f60\u4e0d\u540c\u7684\u89c6\u89d2\u6765\u770b\u5f85\u7c7b\u4f3c\u7684\u77e5\u8bc6\u3002\u540c\u65f6\uff0c\u672c\u4e66\u4f5c\u8005\u8fd8\u8ba1\u5212\u8054\u7cfb\u4e00\u4e9b\u76f8\u5173\u9886\u57df\u7684\u79d1\u7814\u5de5\u4f5c\u8005\u6765\u5206\u4eab\u67d0\u4e2a\u7ec6\u5206\u9886\u57df\u7684\u79d1\u7814\u5b66\u4e60\u8def\u5f84\uff0c\u8ba9 CS\u81ea\u5b66\u6307\u5357 \u5728\u8ffd\u6c42\u5e7f\u5ea6\u7684\u540c\u65f6\uff0c\u5b9e\u73b0\u6df1\u5ea6\u4e0a\u7684\u63d0\u9ad8\u3002</p> <p>\u5982\u679c\u4f60\u60f3\u8d21\u732e\u8fd9\u65b9\u9762\u7684\u5185\u5bb9\uff0c\u6b22\u8fce\u548c\u4f5c\u8005\u90ae\u4ef6\u8054\u7cfb zhangchaowen@stu.scu.edu.cn</p>"}]}